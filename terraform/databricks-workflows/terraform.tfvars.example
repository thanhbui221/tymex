# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your actual values

databricks_host  = "https://your-workspace.cloud.databricks.com"
databricks_token = "dapi1234567890abcdef"  # Generate in User Settings > Access Tokens

dbt_project_path = "/Workspace/Shared/dbt/customer_360"

cluster_id = "1234-567890-abcdef12"  # Existing cluster ID

sql_warehouse_id = "abcdef1234567890"  # SQL Warehouse ID for monitoring

notification_emails = [
  "data-team@company.com",
  "oncall@company.com"
]

# Optional: Slack webhook for alerts
slack_webhook_url = ""  # Leave empty if not using Slack
